# Starship prompt (https://starship.rs)
# Loaded after zshrc_30_path so the binary is resolvable, and last overall so
# nothing downstream clobbers the prompt.
#
# Config lives at ~/.config/starship.toml, symlinked from config/starship.toml
# in this repo by scripts/setup-zsh.sh.

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  # Keep a usable prompt on machines where the brew-bundle step hasn't run yet.
  PROMPT='%F{cyan}%~%f %# '
fi
