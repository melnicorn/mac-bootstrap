# Starship prompt — must come after PATH setup so the binary is findable.
# Config lives at ~/.config/starship.toml (symlinked from this repo by setup-starship.sh).

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  # Keep a usable prompt on machines where the brew-bundle step hasn't run yet.
  PROMPT='%F{cyan}%~%f %# '
fi
